# App
CORS='["*"]'
VERSION='0.0.1'
APP_ENV='dev'
TRACING_ENV_FILE='app/core/settings/tracing_env.json'

# Authentication
SECRET_KEY='{SECRET_KEY}'
TOKEN_EXPIRE_HOURS=87600
ALGORITHM='HS256'
ACCOUNT_FILE='app/core/settings/user.json'



# Chat model (Openai, Gemini, ...)
CHAT_MODEL='gpt-4.1-mini'
CHAT_MODEL_TEMPERATURE=0

#Chat model vision (Openai)
CHAT_MODEL_VISION='gpt-4.1-mini'
CHAT_MODEL_TEMPERATURE_VISION=0

# OpenRouter API
OPENROUTER_API_KEY='{OPENROUTER_API_KEY}'

# Chat history context length
HISTORY_CONTEXT_LEN=5

# Ratelimit
RATELIMIT_REDIS='redis://localhost:6379/0'
REDIS_MAX_CONNECTION_POOL=100
# For ratelimit user in minutes
RATELIMIT_WINDOW_MINUTES=1440


# Checkpointer
CHECKPOINT_HOST='localhost'
CHECKPOINT_PORT=5434
CHECKPOINT_USER='edu'
CHECKPOINT_PASSWORD='{CHECKPOINT_PASSWORD}'
CHECKPOINT_DB='checkpointer'

# Embedding 
EMBEDDING_KEY='{EMBEDDING_KEY}'
EMBEDDING_MODEL='voyage-3'
EMBEDDING_DIMS=1024
DOCUMENTS_TOPK=6

# Vector store (Qdrant)
QDRANT_HOST='localhost'
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# app database
APP_DB_HOST='localhost'
APP_DB_PORT=5435
APP_DB='mentorbot'
APP_USER='edu'
APP_PASSWORD='{APP_PASSWORD}'

# For tracing
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# AG-UI answers: reasoning model (streams "đang suy nghĩ"); empty = use CHAT_MODEL
CHAT_ANSWER_MODEL='openai/gpt-5-mini'
CHAT_REASONING_EFFORT='low'

# For mindmap (MIND_MAP_MODEL also parses the PDFs)
MIND_MAP_MODEL="gemini-2.5-flash"
# Image model of the legacy WebSocket mind map (must output images on OpenRouter)
MIND_MAP_IMAGE_MODEL="google/gemini-2.5-flash-image"
MIND_MAP_MAX_TOKENS=8192
# Output cap of one PDF parse request (no cap = OpenRouter reserves 65535 tokens -> 402)
PDF_PARSE_MAX_TOKENS=32768

# AG-UI agent (POST /agent, GET /threads/{id}/messages) — see docs/AG-UI.md
# Checkpoints go to their own schema of the CHECKPOINT_* database; never share
# tables with the legacy WebSocket graph. A full URL (dedicated DB) overrides it.
MENTOR_CHECKPOINT_SCHEMA='mentor_agui'
# MENTOR_CHECKPOINT_DB_URL='postgresql://user:pass@host:5432/mentor_agui'
MENTOR_CHECKPOINT_POOL_SIZE=10
# Require "Authorization: Bearer <jwt>" + session ownership on /agent and /threads/*.
# The token comes from POST /login ("access_token"); the frontend sends it.
# Set false only for local smoke runs without a token.
AGENT_AUTH_REQUIRED=true
